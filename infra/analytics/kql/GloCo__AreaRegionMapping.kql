// Area → Region mapping per the Row Labels list in configuration/Row Labels.md.
// Emits both User_AreaId (numeric, stable) and User_Area (string, as it appears in
// GloCo_PageViews and the existing CountNotSensitiveUnits>=120 → "CPSD" rewrite),
// so callers can join via whichever side is cleanest. A synthetic User_Area="CPSD"
// row is included so reports that already use User_AreaOrCPSD as the Area column
// (e.g. GloCo_CaseReview_AreaCounts, GloCo_Users_VisitsPerApp) can attach a Region
// via a plain join on Area name.
//
// The only null User_AreaId is the synthetic "CPSD" row — it has no real id, it's
// the label GloCo_PageViews emits via User_AreaOrCPSD when CountNotSensitiveUnits >= 120.
datatable(User_AreaId: long, User_Area: string, Region: string) [
    // CPSD (synthetic dashboard label + component units — covers both join paths)
    long(null),  "CPSD",                          "CPSD",
    1043,        "HMCPSI",                        "CPSD",
    38610512,    "Counter Terrorism Division",    "CPSD",
    38610515,    "Organised Crime Division",      "CPSD",
    38610517,    "Special Crime Division",        "CPSD",
    86292933,    "Proceeds of Crime",             "CPSD",
    131790535,   "SEOCID Int London and SE Div",  "CPSD",
    131790540,   "SEOCID Regional and Wales Div", "CPSD",
    // Cyrmu Wales
    1025,        "Dyfed Powys",                   "Cyrmu Wales",
    1005,        "Gwent",                         "Cyrmu Wales",
    1022,        "North Wales",                   "Cyrmu Wales",
    1019,        "South Wales",                   "Cyrmu Wales",
    // East Mids
    1018,        "Derbyshire",                    "East Mids",
    1037,        "Leicestershire",                "East Mids",
    1034,        "Lincolnshire",                  "East Mids",
    1033,        "Northamptonshire",              "East Mids",
    1041,        "Nottinghamshire",               "East Mids",
