// Per-user pivot of submitted case work: one row per user, one column per review / triage type, cell = pieces
// of work (rows of GloCo_CaseReview_Activity) of that type credited to the user. Each piece of work is credited
// to ONE person — its submitter, else its starter — so the columns sum to the Submitted totals of
// GloCo_CaseReview_WithTriageTotalStartedSubmitted (less the few pieces of work nobody was signed in for).
//
// Each triage type appears twice: as captured, and "(adjusted)" to include the submissions inferred for the
// periods triage submission capture was down. Total and Total (adjusted) likewise.
GloCo_CaseReview_Activity
| where Status == "Submitted" and isnotempty(User_Email)
| summarize
    ["First review"]                = countif(SubType == "First review"),
    ["Subsequent review"]           = countif(SubType == "Subsequent review"),
    ["EA first review"]             = countif(SubType == "EA first review"),
    ["EA subsequent review"]        = countif(SubType == "EA subsequent review"),
    ["Admin finalised"]             = countif(SubType == "Admin finalise"),
    ["Triage OD"]                   = countif(SubType == "Triage OD" and SubmittedObserved),
    ["Triage OD (adjusted)"]        = countif(SubType == "Triage OD"),
    ["Triage ODPCDReview"]          = countif(SubType == "Triage ODPCDReview" and SubmittedObserved),
    ["Triage ODPCDReview (adjusted)"] = countif(SubType == "Triage ODPCDReview"),
    ["Triage DCP"]                  = countif(SubType == "Triage DCP" and SubmittedObserved),
    ["Triage DCP (adjusted)"]       = countif(SubType == "Triage DCP"),
    Total                           = countif(SubmittedObserved),
    ["Total (adjusted)"]            = count()
    by User = User_Email
| order by ["Total (adjusted)"] desc
