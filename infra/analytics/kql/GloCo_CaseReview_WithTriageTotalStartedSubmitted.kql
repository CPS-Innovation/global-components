// Case review and triage totals by type, since launch: one row per type, then Total and Earliest date.
// Built on GloCo_CaseReview_Activity — every figure counts PIECES OF WORK (its rows), not cases: a case with a
// first review, a later subsequent review and two triage tasks is four.
//
//   Started               pieces of work begun (a submitted one was begun even if its start went unrecorded)
//   Submitted             of those, submitted, read "captured (adjusted)": the captured figure, then in brackets
//                         the figure including the submissions inferred for the periods triage submission capture
//                         was down (see GloCo_CaseReview_Activity / GloCo_TriageSubmissions). A row with nothing
//                         inferred — every review row — is just the number. The column is therefore text.
//   Users                 distinct people credited with a submitted (adjusted) piece of work of that type — if a
//                         user did that kind of work, they count
//   User first seen       each user counted once, in their topmost row; sums to the Total's Users
//
// Triage ODPCDReview is split on the submission's IsCPSD; "unknown" = no captured submission, so its Submitted
// reads 0 and all of its bracketed figure is inferred.
let Launch = datetime(2026-03-09T12:00:01);
let RowOrder = datatable(Review_Type: string, SortKey: int) [
    "First review", 1, "Subsequent review", 2, "EA first review", 3, "EA subsequent review", 4, "Admin finalised", 5,
    "Triage OD", 6, "Triage ODPCDReview (CPSD)", 7, "Triage ODPCDReview (non-CPSD)", 8, "Triage ODPCDReview (unknown)", 9,
    "Triage DCP", 10 ];
let A = materialize(GloCo_CaseReview_Activity
    | where Kind != "Streamlined threshold test"
    | extend Review_Type = case(
        SubType == "Admin finalise",     "Admin finalised",
        SubType == "Triage ODPCDReview", strcat("Triage ODPCDReview (", case(IsCPSD == "true", "CPSD", IsCPSD == "false", "non-CPSD", "unknown"), ")"),
        SubType)
    | lookup RowOrder on Review_Type);
let FirstSeen = A
    | where Status == "Submitted" and isnotempty(User_ObjectId)
    | summarize SortKey = min(SortKey) by User_ObjectId
    | summarize User_First_Seen = count() by SortKey;
let Rows = RowOrder
    | join kind=leftouter (A | summarize Started = count(), Submitted = countif(SubmittedObserved),
                                        Adjusted = countif(Status == "Submitted"),
                                        Users = count_distinctif(User_ObjectId, Status == "Submitted" and isnotempty(User_ObjectId))
                             by Review_Type) on Review_Type
    | join kind=leftouter FirstSeen on SortKey
    | project Review_Type, SortKey, Started = coalesce(Started, 0), Submitted = coalesce(Submitted, 0),
              Adjusted = coalesce(Adjusted, 0), Users = coalesce(Users, 0), User_First_Seen = coalesce(User_First_Seen, 0);
let TotalRow = A
    | summarize Started = count(), Submitted = countif(SubmittedObserved), Adjusted = countif(Status == "Submitted"),
                Users = count_distinctif(User_ObjectId, Status == "Submitted" and isnotempty(User_ObjectId))
    | extend Review_Type = "Total", SortKey = int(11), User_First_Seen = toscalar(FirstSeen | summarize sum(User_First_Seen));
let DateRow = A | summarize D = min(coalesce(StartedAt, SubmittedAt))
    | project Review_Type = "Earliest date", SortKey = int(12), Started = format_datetime(D, "yyyy-MM-dd HH:mm");
let Body = union Rows, TotalRow;
union
    (Body | project Review_Type, SortKey, Started = tostring(Started),
                    Submitted = iif(Adjusted == Submitted, tostring(Submitted), strcat(Submitted, " (", Adjusted, ")")), Users = tostring(Users), ["User first seen"] = tostring(User_First_Seen)),
    DateRow
| order by SortKey asc
| project-away SortKey
