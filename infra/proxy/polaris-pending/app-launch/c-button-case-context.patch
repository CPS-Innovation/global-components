+// The case a C button press came from, or "" if there isn't one. On a case page CMS's own
+// openCaseworkTools adds q={"caseId":<id>} to the launch URL, as it does for the P button.
+// Anything else (no q, a repeated q, another shape) is "no case". Digits only, because the id
+// goes into the URL we redirect to.
+function caseIdFromQuery(q) {
+  if (typeof q !== "string") {
+    return "";
+  }
+  let text = q;
+  // CMS encodes q before adding it to the URL, so it can still be encoded after njs decodes r.args.
+  if (text.indexOf("%") !== -1) {
+    try {
+      text = decodeURIComponent(text);
+    } catch (e) {
+      return "";
+    }
+  }
+  const match = /^\s*\{\s*"caseId"\s*:\s*([1-9][0-9]{0,9})\s*\}\s*$/.exec(text);
+  return match ? match[1] : "";
+}
+
+// Where the launch ends up: the case's overview page when launched from a case, otherwise the
+// casework home page. Every tier lands on the same pages (FCT2-21520 moved prod off
+// casework_blocks/home, the last per-target difference).
+function landingUrl(os, caseId) {
+  return caseId
+    ? `https://${os}/WorkManagementApp/CaseOverview?CaseId=${caseId}`
+    : `https://${os}/casework/home?IsFromCMS=True`;
+}
