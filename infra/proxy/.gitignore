# Build output
dist/

# Test build artifacts
.dist/

# Compiled JavaScript files (keep nginx.js which is not ours, and test files)
config/**/*.js
!config/main/nginx.js
!config/main/cmsenv.js
!config/**/tests/*.js
!config/**/main-reference/*.js

# Deployment secrets and backups
deploy/secrets.env
deploy/backups/

# Environment config files (contain secrets)
config/main/.env
config/global-components.vnext/.env
config/global-components.watchdog/.env*
# .env.example is the committed documentation of those keys
!config/global-components.watchdog/.env.example
# The pre-2026-11-10 home of the same files — kept ignored so a stale copy left
# behind by a branch switch can never be committed.
config/global-components.cms-auth-presence/.env*

# Local mkcert output for the proxy dev stack — generated on demand by
# whichever branch wires up the dockerised proxy. Lingering on disk after
# branch switches; safe to ignore globally.
docker/certs/

# Personal, uncommitted deploy/helper scripts
*.local.sh
