# Environment variables for the cms-auth-v2 proxy flow.
#
# Copy to `.env` (gitignored) and fill in the two secrets below. The deploy
# script (deploy-cms-auth-v2.local.sh) reads THIS file and injects them into the
# compiled .js at build time — the destination server has no app settings.

# ---------------------------------------------------------------------------
# REQUIRED for deploy — injected at build time from this .env
# ---------------------------------------------------------------------------
# The .ts carries @@...@@ dropzone tokens for these two (the only values without
# a baked-in default). The deploy script substitutes them into dist/…v2.js before
# upload. CLIENT_SECRET is mandatory for the /init-v2/callback token exchange;
# STORAGE_KEY may be left blank (the Table Storage write/read just SKIPs).
CPS_GLOBAL_COMPONENTS_CMS_AUTH_CLIENT_SECRET=your-app-client-secret
CPS_GLOBAL_COMPONENTS_CMS_AUTH_STORAGE_KEY=your-storage-access-key

# ---------------------------------------------------------------------------
# Baked-in QA defaults — NOT injected, NOT set here
# ---------------------------------------------------------------------------
# These four have hard-coded QA defaults in global-components.cms-auth-v2.ts. The
# deploy does not template them; to target a different tenant/app/host/account,
# edit the defaults in the .ts. (They are also honoured from process.env at
# runtime, which is how the docker integration tests supply mock values — but the
# deployed server has no such env, so the .ts defaults are what ship.)
#   CPS_GLOBAL_COMPONENTS_CMS_AUTH_TENANT_ID       (default: QA tenant)
#   CPS_GLOBAL_COMPONENTS_CMS_AUTH_CLIENT_ID        (default: QA app client id)
#   CPS_GLOBAL_COMPONENTS_CMS_AUTH_REDIRECT_URI     (default: .../init-v2/callback on QA)
#   CPS_GLOBAL_COMPONENTS_CMS_AUTH_STORAGE_ACCOUNT  (default: sacpsglobalcomponents)

# ---------------------------------------------------------------------------
# nginx ${...} substitution vars — server provided, NOT set here
# ---------------------------------------------------------------------------
# The v2 .conf references these nginx template vars:
#   ${WEBSITE_DNS_SERVER}   — active (resolver for the /init-v2/ ngx.fetch locations)
#   ${CMS_RATE_LIMIT_QUEUE}, ${WEBSITE_SCHEME} — only in the commented-out
#                             /CMS.../uaulLogin.aspx interception block
#
# They already exist in the deployed server's environment. The deploy script
# ships the .conf with the ${...} placeholders intact and the server's own nginx
# envsubst resolves them. They are only substituted for local integration
# testing, where docker-compose provides them (e.g. WEBSITE_DNS_SERVER=127.0.0.11).
